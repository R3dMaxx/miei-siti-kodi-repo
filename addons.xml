<?xml version="1.0" encoding="UTF-8"?>
<addons>
<addon id="plugin.video.miei_siti" name="MediaHub Italia" version="0.1.6" provider-name="Personal">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="plugin.video.youtube" version="6.8.10"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="it_IT">TV, guide dei programmi e liste M3U personali in un solo addon</summary>
    <description lang="it_IT">Canali Live gratuiti Rakuten TV, canali YouTube, liste M3U e guida TV serale XMLTV configurabile. Non aggira DRM, autenticazione o restrizioni geografiche.</description>
    <platform>all</platform>
    <license>MIT</license>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>

</addons>
